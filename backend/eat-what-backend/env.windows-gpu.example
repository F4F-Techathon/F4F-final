# Windows：配音走阿里云百炼实时 Qwen3-TTS（云端，地方菜店主用方言音色），Whisper 识别跑在 GPU 上（说明见界面目录 docs/windows-gpu.md）。
# start_api_windows.cmd 第一次运行时会把它复制成 .env.local。
# 这里不放任何密钥：start_api_windows.cmd 让后端原地读取界面目录的 .env.local / .env（EAT_WHAT_ENV_FILES）。

# 手机舞台可能在两句之间暂停，回执要多等一会儿
PLAYBACK_ACK_TIMEOUT_SECONDS=600
LLM_TIMEOUT_SECONDS=30
LLM_REASONING_EFFORT=none

# 配音：阿里云百炼 qwen3-tts-flash-realtime（WebSocket 实时合成）。密钥 DASHSCOPE_API_KEY 写在界面目录的 .env.local。
# 四川话、粤语、上海话、闽南话、陕西话、天津话的店主自动用对应方言音色。本地 CosyVoice 3 已停用（改回 cosyvoice-http 即恢复）。
TTS_PROVIDER=dashscope

# 识别：faster-whisper 在 CUDA 上跑 large-v3-turbo（首次使用时自动下载）
# 显卡出问题时临时改成 WHISPER_MODEL=small、WHISPER_DEVICE=cpu、WHISPER_COMPUTE_TYPE=int8
# 配音按整句合成，最多提前 TTS_SEND_AHEAD_SECONDS 秒发给手机；合成快于实时时每句先攒 TTS_PREBUFFER_SECONDS 秒再播，慢于实时时整句合成完再播。
# TTS_SEND_AHEAD_SECONDS=15
# TTS_PREBUFFER_SECONDS=1.2

WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
