# Copy this file to .env.local. Never commit .env.local.

# LiveKit Cloud or self-hosted LiveKit. Switching these three values requires no code changes.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=restaurant-host

# OpenAI-compatible LLM provider. `deepseek-pro` needs the Base URL supplied by its provider.
LLM_BASE_URL=
LLM_MODEL=deepseek-pro
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=40
LLM_TRUST_ENV=0

# The standalone TTS service uses its own Python 3.10 environment.
TTS_PROVIDER=cosyvoice-http
COSYVOICE_URL=http://127.0.0.1:8772
COSYVOICE_DIR=runtime/CosyVoice
COSY_FP16=1
WHISPER_MODEL=small
# Start with CPU STT. On the tested Windows NVIDIA host: cuda / int8_float16.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

