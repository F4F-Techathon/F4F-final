ile.com/pc/AL-hJf4r_DsjsFX3F2H65FBEcYADLfL87f7-HuYhd8tjNtUKm7Dz2-4uW9BLikuYElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"2800134206","user":"四**","time":"2025年8月14日","star":5,"text":"就是个普通的拌粉，加几块牛肉都快30了，咋敢定的价，粉的分量少，加粉还要一元，还要等老久，太差劲了","likes":0,"images":[]},{"id":"2799969175","user":"萧**","time":"2025年8月14日","star":2,"text":"这家完全不会做餐饮，高峰期位置本来就少，能扫码点餐解决的事为什么还需要排队点单？排队就算了，本来份量就不大，加个面居然还要收1元，这1元还需要再排队去前台加这1元，明明点餐码下单就能解决的事要让顾客起身排队才能完成，这很不合理。好不容易把下\n性价比：单的面加上了，上粉速度又很慢，不催就不上，加个面是什么很困难的操作吗？\n\n最后你叫号自取就自取，但是你叫号的声音搞这么小干啥？那个小的电子屏也根本没人注意到，声音小就算了，点个套餐连托盘都没有让顾客怎么端这么多面和小食？\n\n可见整个店的逻辑完全不对，流程都是混乱的，再不改进菜量和上菜流程估计活不过一年","likes":0,"images":[]},{"id":"2789053743","user":"R**","time":"2025年8月9日","star":1,"text":"服务：服务很差，没有托盘，一堆东西让人跑两三趟去拿，服务员在旁边站着，完全没有帮忙的意思。\n口味：椒麻鸡有腥味，牛肉很柴，不好吃","likes":0,"images":[]},{"id":"2772878510","user":"佳**","time":"2025年8月2日","star":2,"text":"味道真的很一般…","likes":0,"images":[]}]}
