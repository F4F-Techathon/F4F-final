xviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3503349380","user":"真**","time":"3天前","star":4,"text":"在隔壁健身完，随便吃个晚饭\n\n口味：\n「西安手工凉皮」有点偏咸，老板送的小菜也是\n上次和朋友一起，点的「油泼扯面Biangbiang面」味道很不错，值得下次来吃\n\n服务：一般吧，饭好吃就行\n👫🏻排队：一般不怎么排队","likes":0,"images":["https://qcloud.dpfile.com/pc/SwnQoqRs_tG95dm53KcAk-ArvtiK4BWUAYNi5apra8q1odS7pG_T0qKotF2R5BZDElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3498964298","user":"A**","time":"5天前","star":4.5,"text":"比较正宗的一家店，他家油泼面挺好吃的，面食很劲道，完了以后套餐里面还送饮料，店里面的一个红枣茶蛮好喝的，搭配的小菜也还行，给的分量很足，所以的话就整体都还可以，而且里面的阿姨特别的热情周到，会主动来问说面试要什么样的面，然后也会主动说有免费的小菜，各方面可以吃，整体还是不错的。肉夹馍可以选择两种吃法，很特别","likes":0,"images":["https://qcloud.dpfile.com/pc/tE11lmtpd-Korpf7woJTbiyrArSkYV1jjl0whqXF_S-z0YqA33Bvt19E2c2lC-3DElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3497380240","user":"蓝**","time":"6天前","star":3.5,"text":"整体味道还行，面条是宽面，挺有嚼劲的。酱料给得算足，拌开之后每根面都能裹上汁。臊子和西红柿鸡蛋拌在一起味道不错，咸淡适中。配上冰峰挺解腻的，24块多性价比还可以，冰峰就是正常味道，没啥特别的。打卡送了凉拌菜，吃起来还可以，当个工作餐吃挺合适的","likes":0,"images":["https://qcloud.dpfile.com/pc/dxFQygibhg2QVPjkEZxnvKAUEaT-um1b1afe5BQs95B-KD-nhepyxOE9SiVw2KmgElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3462177503","user":"J**","time":"9月22日","star":4,"text":"张江这里新开的回味西安，中午过去试了𰻞𰻞面。\n口味：配料挺丰富，豆芽、青菜、牛肉配上辣子，拌匀很香。面条口感还不错，分量足。\n环境：店里环境干净，但信号很差，建议先连Wifi再点餐。\n服务：打卡可以送饮料，出餐速度快。\n性价比：作为工作简餐很合适，路过可以尝尝。","likes":0,"images":["https://qcloud.dpfile.com/pc/PWIG6IO9wLWXuXvm-Ws-yqZOd1bRt-QSrCfT_-VY2TnnnBFtSjM8irY7bp-UgvRAElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/bofmlrji425S4Nl8SppXSZdHvkoNo1pOcj1x61th7aZ1w338Sf40M6iWk-zlYZOyElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/vKAnE2QE06evXiFu-U8SLjjOBfL73Ru5HtKysK0THnbq2ggxK-VAkfrMjsTTPq4ZElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/7qgQSzCJ1Xw0ygkHcDH01zjXH5Ws7as7Wwh3uotPNggj6adDJQq4mFs21-ZjpVbEElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3448963737","user":"人**","time":"9月14日","star":3.5,"text":"回味西安氛围感十足，满是西北风情，店内大雁塔壁画、竹编吊灯很有代入感。点的双拼biangbiang面，宽面筋道爽滑，番茄鸡蛋鲜香，小炒肉入味，搭配青菜配菜丰富。可以免费加面，分量实在。明档厨房看得见制作，出餐较快。搭配冰峰汽水，地道陕西体验。就餐环境热闹，适合简餐。","likes":0,"images":[]},{"id":"3442793382","user":"S**","time":"9月10日","star":4.5,"text":"个人很喜欢西安的面食，跟本帮江浙面比风格有点粗旷锅气十足。\n这家店在公司附近，偶尔会跟同事们一起来吃午饭。\n店面环境也挺好，干干净净，这家油泼面很好吃，这个应该算油泼扯面，比较宽很劲道，油泼后激发了辣椒和蒜的香，特别好吃","likes":0,"images":["https://qcloud.dpfile.com/pc/waaRQAQCtW0etVdpw4nforwqlzRdzbTAfeDQiJ7Py0AlSUr6Q2YNl9lmKxhXYV60Elc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/rp-R68Pj2QQPeuOgNCdIs6d2Ti4RKc_osmONANrfK1qAnOfUGapxJ2qZRpzsZB7JElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3430638887","user":"匿**","time":"9月2日","star":2,"text":"味道很一般的一家店，肉夹馍有白吉馍和酥馍两种可以选，我就选了前者，白吉馍吃起来还是挺香的，比较有嚼劲，卤肉的味道也还行，但肉量一半\n麻酱凉皮的味道就一言难尽了，麻酱是很稀的那种，吃完都是汤的那种，所以就没啥味道，大家千万别点","likes":0,"images":["https://p0.meituan.net/coverpic/567044131c5366267f285f9a00d3d20c261768.jpg%40400w_400h_1e_1l%7Cwatermark%3D0.webp","https://qcloud.dpfile.com/pc/U1h0bIlepMIenQf1OoMwnhY7j0SmJNo0ZcVMfL1Z8LNDvgJa74kjDv2nc1yxISulElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/Ozg4-3jBhiJGzkeA927GkYObEQYplRk5AddcDoSnesNBw1HmopT0pH_Id9YVM3tdElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/LWCiBHXlL6FFRcVVezFN21xAD31240-zqUqfLPV8zmk2Vjb5915llVjv5IC0sqw9Elc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3416507630","user":"澄**","time":"8月24日","star":4,"text":"地方有点难找，在一排门面房后面，不是路边\n口味～肉夹馍选了潼关味的饼，焦脆，还挺好吃的，擀面皮中规中矩吧，涮牛肚的酱里面的花生酱放多了，有点甜\n环境～还算干净卫生的小馆子\n服务～服务员是个年轻小姑娘，又麻利又热情\n性价比～三样菜品一共五十出头","likes":0,"images":["https://p0.meituan.net/ugcpic/f673d0e747165b8982631356faeaaf7e435249.jpg%401080w_1080h_1e_1l%7Cwatermark%3D0.webp","https://p1.meituan.net/ugcpic/474613cb7296ce98e4f7d89f5434680e321221.jpg%401080w_1080h_1e_1l%7Cwatermark%3D0.webp","https://p1.meituan.net/ugcpic/dcece7ae833a11efae996114c8a0d922534445.jpg%401080w_1080h_1e_1l%7Cwatermark%3D0.webp"]},{"id":"3413291210","user":"小**","time":"8月23日","star":4,"text":"走进“回味西安”那会儿没抱啥大期望，毕竟上海这种仿古风小吃店太多了。但！当我咬下第一口肉夹馍，那个酥脆的皮儿在嘴里裂开，卤肉的香味直接往脑门儿上冲——完蛋，这不就是前年秋天在西安回民街吃到的那个味儿吗？\n凉皮是那种薄薄透透的，辣椒油红亮但不燥，醋香味儿特别正。我拌的时候特意多搅了几下，让每根皮子都裹上汁，吸溜一口，酸辣带着面香，后味儿还有一点点回甜。跟西安街边小摊上吃到的简直一摸一样。\n最绝的是“冰峰”打开的那个瞬间，气儿“嘶”地一声冒出来，喝进嘴里的橙子味儿跟记忆里在兵马俑门口喝的那瓶完全对上了。一口凉皮一口肉夹馍再灌一大口冰峰，整个人都舒坦了。\n说实话，在上海能吃到这种原汁原味的“三秦套餐”不容易。很多店都改成了本地人习惯的口味，反而没了魂儿。但这家的味道就是倔，原原本本把西安街头的烟火气搬过来了。\n吃完打个饱嗝，嘴里还留着辣油和碳水的幸福感。就冲这口儿，下回得试试他们家𰻝𰻝面，希望能一样惊艳。","likes":0,"images":["https://qcloud.dpfile.com/pc/z4XqzDwsyQAwfSm-Yd0U6KNIWTwk4pQJSTpsNPZTkMx8MLbdedcbsCYB4pwQc3AzElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/FWwlxnDJ_B5kRpjbAPJ2xro74y0PZErfSIHFLvvC48uiQkEVP7chh0tHPRu3aZcjElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/9aqqzRrNAlLdB1kx27Eq-_yGhSZrVEfaiM1vuamPdoWZ0xR3ShwOv4GKfvCLMyu2Elc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/78woVRY_X4828v39q0DSMqSxiWXydGKQjqgkzDC4awloClqPTAkaY2SfAyWNhaGxElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3413144478","user":"王**","time":"8月23日","star":4,"text":"味道非常好，喜欢不要错过棒棒哒","likes":0,"images":[]},{"id":"3411421898","user":"R**","time":"8月22日","star":4,"text":"说实话东西是不贵性价比挺高的 但是味道一般 至少和平时吃的子午路比 差的有点多","likes":0,"images":[]},{"id":"3409549499","user":"匿**","time":"8月21日","star":3,"text":"肉夹馍还可以，麻酱凉皮的的酱汁太淡，不够浓郁","likes":0,"images":["https://p0.meituan.net/coverpic/8b7576970b24180979a6d349add34200190104.jpg%40400w_400h_1e_1l%7Cwatermark%3D0.webp","https://qcloud.dpfile.com/pc/-uoEjeYanB7y_A4ZPZeu7gQ2IX2wsOH3dsqVWskILHWagMKYijuqRuYdMllUT2t3Elc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3409285734","user":"没**","time":"8月20日","star":4.5,"text":"吃过两次，味道还可以，那周边都是一些很小的店，这家店大一点，座位多一点，就是位置有点偏","likes":0,"images":[]},{"id":"3399268172","user":"K**","time":"8月15日","star":4.5,"text":"正宗陕西风格 很香很好吃 \n口味：「油泼扯面Biangbiang面」","likes":0,"images":[]},{"id":"3397986169","user":"I**","time":"8月14日","star":5,"text":"在小区对面的底商里，中午去的早人不算多，老板娘带着北方的的爽朗，会贴心的建议可以点小份，因为大份基本都吃不完，事实的确如此，味道很正，有之前在西安吃到的感觉，还有冰峰，建议小菜可以换点北方人爱吃的醋泡花生米或者芹菜花生之类，哈哈","likes":0,"images":["https://qcloud.dpfile.com/pc/aAZxGRlVGCrrgSz-HtxRZLJ-613bb-78XbNEceSjjMvLF63Iiymxfmi8Ymq70ojjElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3396944229","user":"人**","time":"8月13日","star":5,"text":"口味：「现烤西安肉夹馍」肉夹馍🥙很香，馅料给的很足，工作日人也蛮多的，生意很好，买套餐里面送可乐，夏天很适配。如果再配一份面就吃不完了，但是面很好吃，油泼面的浇头在饿的时候简直了，服务也还行，靠窗的玻璃很亮，拍了张照片朋友问我为什么坐在外面，笑死","likes":0,"images":[]},{"id":"3389804428","user":"匿**","time":"8月9日","star":4.5,"text":"这家面馆不在路边，在第二排，不过里面看着挺干净宽敞的。团购的套餐性价比很高。「西安手工凉皮」份量还行，味道也在预期内，夏天吃挺清爽的。「现烤西安肉夹馍」选的白吉馍，馍是现烤的，表皮烤脆了还是挺好吃的。适合附近来解决个午餐。","likes":0,"images":[]},{"id":"3387512043","user":"0**","time":"8月8日","star":4,"text":"早点下班过来，还没到晚市，服务员都在休息，进门找服务员核销。通过vip购买的优惠套餐，一份凉皮➕一个肉夹馍➕一罐饮料。选的是麻酱口味的，潼关肉夹馍（终于分清楚了，白饼的是西安，脆皮的是潼关），还是最喜欢吃潼关的肉夹馍，要了一罐冰峰（这个更适合西安）。","likes":0,"images":["https://qcloud.dpfile.com/pc/aKqOEbS4zn1evElV1IuB9NQgdYnZ-v1SdjgRi_vXMmaC4I3N3b9wH_6-sTcmHYEkElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/NDoQ1OrmmC_I_tdzxpo-Kno5e_Mgln_hne6YV9uwghSdvPhyHFMWmwuPE7A342WSElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/HINj1L3SDFnbUSaNrvRE0_uocIEEB1EEp8vA-r1gzkB1w338Sf40M6iWk-zlYZOyElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3387510642","user":"匿**","time":"8月8日","star":5,"text":"环境：这家餐厅位置优越，还是蛮好找的。店内环境整洁明亮。\n服务：店员服务态度还挺好的。\n口味：「油泼扯面Biangbiang面」面条是手工现做的，还蛮劲道，浇头量足，味道不错。\n性价比：整体性价比还行，值得一去。","likes":0,"images":["https://qcloud.dpfile.com/pc/gilV0KyNw-OnWid0S_l6eQ-T7zi7mGPRaAR9RK3OHA_klvs-mRu_-lMBm_LTYsLgElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/-87yDfDcfZeoop3lL6FevwqzXIn08yp2RnxzecXDti19FIF4k7fnvYbKqvPAugWxElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/4_2qtO3XM__f6-Y1SuBdCsAacix0wxEaGhfXtFHFxjaGFAsHHLX_K0YH1kC2VZwkElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3386713621","user":"灵**","time":"8月7日","star":4.5,"text":"店面挺宽敞的，适合堂食。吃的臊子面，还可以