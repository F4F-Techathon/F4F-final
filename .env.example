# 复制为 .env（或开发时的 .env.local）再填写。这两个文件都不进 git、不进交接包。
# 所有变量都在服务端读取；页面构建里不含任何 key，同一份构建换个 .env 就能在别的机器上跑。

# ── 需求整理（首页语音 → 需求卡）：OpenAI 兼容的 Chat Completions 接口。不配时停在需求页。 ──
LLM_API_KEY=
LLM_BASE_URL=https://api.gpt.ge/v1/
LLM_MODEL=gemini-3.8-flash
# 默认 none：关掉模型思考，需求整理更快，也不会因思考占满 token 而截断。不支持该参数的模型可设为空。
LLM_REASONING_EFFORT=none

# 备用模型：上面的设置失效（连不上、密钥被拒、模型不存在、服务出错、超时）时，所有智能体（需求整理，以及多智能体
# 后端的调度器和各家餐厅）自动改用它，之后 5 分钟内先用它。建议写在单独的 .env 里。
# LLM_FALLBACK_BASE_URL=   # 密钥发放方给出的 OpenAI 兼容地址，不能凭模型名推断
# LLM_FALLBACK_MODEL=deepseek-pro
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_REASONING_EFFORT=
# LLM_FALLBACK_COOLDOWN_SECONDS=300

# ── 多智能体后端（Backend/eat-what-backend，./start_mac.sh）。辩论页经 /api/agents/realtime 连接它；没启动时由导演台驱动。 ──
# AGENT_BACKEND_URL=http://127.0.0.1:8771

# ── Jev 表演决策与店主形象生成（TypeSafe）。不配时用关键词基线和关键词规则。 ──
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# ── 高德地图 JS API 2.0（Web 端 key 与安全密钥）。页面启动时从 /api/config 读取，不配时地图不显示、滑卡照常。 ──
# 旧名 VITE_AMAP_KEY / VITE_AMAP_SECURITY_CODE / VITE_AMAP_SERVICE_HOST 仍然有效。
AMAP_KEY=
AMAP_SECURITY_CODE=
# 可选：高德推荐的安全代理地址。设置后安全密钥由代理附加，不再下发到页面。
AMAP_SERVICE_HOST=

# ── 网络：TypeSafe 在部分地区直连会返回 451，这时让服务端经代理访问。 ──
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# ── 运行（npm start / start.sh / start.bat）。 ──
# PORT=3000
# HOST=0.0.0.0
# 手机经局域网打开时，麦克风要求 HTTPS：给出证书和私钥文件（相对项目根目录或绝对路径）即改用 HTTPS。
# TLS_CERT_FILE=certs/cert.pem
# TLS_KEY_FILE=certs/key.pem

# ── 开发（npm run dev / npm run director）。 ──
# 导演台开发服务（5174）默认把 /api 转给 5173。要转给别的服务，在命令行设：
#   DIRECTOR_TARGET=http://localhost:3000 npm run director
# 构建时选数据：默认 66 家大众点评真实店铺；demo 为 9 家手写演示餐厅。
# VITE_DATASET=demo
