n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/4m_VqRcU01Sw5ScAcI7oP48XHKIXhQ8n3MFrCAJOY6o_61YyjGCvJjRk3xxf1KrBElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3490029151","user":"a**","time":"10月6日","star":4.5,"text":"现在天气热了，吃完午饭，特别想喝冷饮，正好路过这家店，大众点评上团购的券，性价比很高，到场一会儿就做好了，等待时间挺短的～\n蜜桃奶冻，有明显的桃子果肉，而且味道也很清新，个人挺喜欢的，后面应该还会再回购的～","likes":0,"images":[]},{"id":"3475628032","user":"蛋**","time":"9月30日","star":4,"text":"饭后整杯奶茶，正好路过茶百道，发现茶百道也做咖啡了，于是买了杯尝了尝\n点了「杨枝甘露」和「埃塞瑰夏拿铁」，杨枝甘露是招牌，口感还是不错的，拿铁看着店员制作，都是真材实料，加奶和咖啡，口感也还可以，下次试试美式如何","likes":0,"images":["https://qcloud.dpfile.com/pc/vfL-deegvM4L67wZEE_KfN-aNdzHvxMzl-xCj6ynaW0Ms8cI2uZE4rR9UeAIKWXoElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/HzZSYRmWJuQ-0Y0hvflPp28FnbDYd1ybjqTAHfc0SUHG4ETFh8RUZIO3srTh_HFgElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/tZN_W-XkGKKmnQgLnSwkoZcnaHunrj8mE1yNK_QvI_Q_61YyjGCvJjRk3xxf1KrBElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3471326704","user":"鲜**","time":"9月28日","star":4.5,"text":"我宣布 现在平价连锁茶饮品牌 美式咖啡\n在我心中的排名是\n茶百道＞manner，b3＞库迪＞瑞幸\n \n今天终于去喝了茶百道六元一杯的埃塞瑰夏美式\n这一入口的花香味好明显啊！就是埃塞豆的那股味儿！六元！性价比无敌\n \nmanner涨价以后很少喝了，库迪铂金有优惠的时候会喝喝，瑞幸嘛，给过他很多次机会了，从来没让我失望的难喝过\n \n店里还有咖啡渣可以自取～","likes":0,"images":["https://qcloud.dpfile.com/pc/5ydszcwYrOYG4Xt6cMSDCag7hXWNXfSGVCo_0_j0z0MlPC9eOYWA4SOzX3qdbI-DElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/lMtqknDbXfLSurFHv7mGV6BHyEEF6IZU37UXO7LlF6QnMTSshExi2dEV03OUh4_hElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/1J507Zulm3spCfMoia1uQaPBUacMpdaHmeF6r-13CAHcGT80wK4u6lZ8_HLYVt5oElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/9D-ZAZbSmw7hh9GHTKHr1uVHrCiYjV7eS-GZh-iyYfJuS1VYoXRFRT6ASDSzhIWHElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3451888201","user":"Q**","time":"9月16日","star":5,"text":"前方显示0单，我等了十几分钟 一直显示制作中，我不进去问根本不给我。还一直在那里狡辩，点一个制作完成让客人来取这么难吗？。态度真差 呕了\n服务：拉垮\n看到没，我下单的时候是11:45。 做好了不给我是什么意思。太生气了。 一样的茶百道不一样的服务","likes":0,"images":["https://qcloud.dpfile.com/pc/FPmiUKzWIHxDgCPoSzJZXJ1prbEczdUi3mFdtpp0IKc-yc89spU8n1BsbjZZSdGEElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3446831490","user":"轻**","time":"9月12日","star":5,"text":"豆乳米麻薯一点都不腻，厚厚的麻薯，浓郁的奶味，真的巨好吃，喝了一口麻薯还想再喝一口麻薯，吸着吸着中杯很快被我干完，所以下次要点大杯，才能喝到爽，马上快来大姨妈，所以我不敢点冰的，只能点常温的，夏天虽然热，但这杯好喝的豆乳米麻薯都让忽略温度。","likes":0,"images":[]},{"id":"3431098964","user":"然**","time":"9月2日","star":5,"text":"茶百道的薄荷冰奶深受我老公和小朋友的喜爱。\n现在一说到喝奶茶，别的都不要喝，只要喝薄荷冰奶。\n我比较喜欢喝他们家的水果茶，甜度适中，茶底也完全不涩，每次点的都是少冰，喝完一桶再吃点水果就已经饱了。\n下次去准备尝试其他品类，希望能够多出一些新品。","likes":0,"images":["https://p0.meituan.net/ugcpic/7c7823ed7023f05ddaf930ae47a1523d552821.jpg%401080w_1080h_1e_1l%7Cwatermark%3D0.webp"]},{"id":"3429444880","user":"匿**","time":"9月1日","star":5,"text":"👫🏻排队：人还好，不是很多\n🅿️停车：马路边可以临时停车\n性价比：我最近都是选自提，然后线上先买好，然后线下拿性价比还是挺不错的\n服务：每次来都是一个小姐姐服务态度挺好的，整体还是非常推荐的，最近非常非常喜欢酸奶紫米露，基本每天都买","likes":0,"images":[]},{"id":"3419962080","user":"匿**","time":"8月27日","star":5,"text":"我对服务很满意，两个服务员态度很友好可亲。","likes":0,"images":[]},{"id":"3419633313","user":"开**","time":"8月26日","star":5,"text":"环境：茶百道(荣科路店)在张江镇荣科路402号1层，位置挺好找的，一家老店了，店面不是很大，这边吃的喝的都挺多的，有很多公司工作日人还是挺多的，中午和同事过来点一杯，等了一小会，夏天喝点「西瓜啵啵」很清爽的，","likes":0,"images":[]},{"id":"3357582432","user":"野**","time":"7月21日","star":4.5,"text":"抖音团了一个佛手柑的大杯券，柑橘类的水果自带夏日清爽的感觉。就是不太酸，比较偏向于纯甜。我感觉果茶尤其是柠檬柑橘之类的果子带点酸味才好喝，纯甜喝起来就是小糖水，没有果茶的感觉了。这是我个人对口味的建议哈","likes":0,"images":["https://qcloud.dpfile.com/pc/v3GcoboYntzUWIyr5F2CaNKuPkI_eOqB_mtP7gsyo9mbna9YjXeL_LXIL_S6qOoHElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/rcgpGgDfbNCUIWoO5jkwZc1fDWbA6hMo6qK9FtrvQ-u40sNkxHoWxDSVkpCvwA8yElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/_B_xTfDgXwwJmHsZlqLsTfEc3wNp5OqQ-zWib042XBpBw1HmopT0pH_Id9YVM3tdElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3348774391","user":"匿**","time":"7月16日","star":5,"text":"喜欢茶百道的麻薯奶茶，夏天天气太热了，出门在外得买杯奶茶解解暑气，附近园区最近的就是这家茶百道奶茶店了。今天发现店里还有「杨枝甘露」，就也买了一杯尝尝。比起一点点的同款「杨枝甘露」奶茶要更浓郁一点，加的西柚果肉也更多","likes":0,"images":[]},{"id":"3337033288","user":"匿**","time":"7月8日","star":3.5,"text":"今天特价团里看到了茶百道的茉莉花茶，所以决定试一试。哎呀，不加糖的茉莉绿茶真的太难喝了！🍵 感觉像是在喝草汁一样，完全没有灵魂。😔 还是加点糖比较对味，不然真的喝不下去。下次还是乖乖点全糖吧！不然这杯茶真的要贡献给地球了。🌍 #无糖绿茶 #真的难喝 #求糖","likes":0,"images":[]},{"id":"3334203101","user":"匿**","time":"7月7日","star":5,"text":"售后真的很差，客服态度也不好。我朋友送了我张券说没有录取记录，拿出截图后又改口，最后说配个五元券，但我那张券赔不了，避雷茶百道，以后都不会买了。本来就不好喝售后客服有这么差，倒闭也是迟早的事，烂死了。","likes":0,"images":[]},{"id":"3322312672","user":"一**","time":"6月29日","star":4,"text":"从成都的小牌子喝到现在全国连锁店。茶百道也算是\"养成系\"了。店铺越来越多，产品也越来越丰富，但豆乳玉麒麟和西瓜啵啵还是心头好，希望别为了扩张丢了初心。希望有越来越多的活动和团购，以及产品的创新和开发。","likes":0,"images":["https://qcloud.dpfile.com/pc/FClUU4gN6tWx3jBq1QD-ofqyKt3tQ-cH9_oRKHBbQSa_D-twraKqd34lhyIgMh_vElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3322080398","user":"小**","time":"6月29日","star":4.5,"text":"环境：来附近吃面看到有家茶百道就来尝尝他家香草冰淇淋拿铁，店铺不大。\n服务：周末下午店里就一个人，堂食和外卖订单都还蛮多的，出餐速度就相对较慢。\n口味：香草冰淇淋拿铁很好看，一整颗冰激凌，味道很不错，不知道为什么不是所有的店铺都有咖啡，他家咖啡劲有点大，喝完心里一直慌慌的\n性价比：最近活动很多，性价比很高。","likes":0,"images":["https://qcloud.dpfile.com/pc/eGDTAW-P7RwH7atykd2tibeyL1n7mYlo8Rpk3SqeFF0c-k9aYpuToyTA6Xs5owJhElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/RtQHG2W8ceiohQ29oGBvm86IVagfzU6kQdo0qDltsp6yvJFuRt5lMzwhoVxsfrxBElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp","https://qcloud.dpfile.com/pc/p7BMPkR5qqlRrTw8EbxNdxhAhrNGnM4ps9OtO2nBwml9FIF4k7fnvYbKqvPAugWxElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3316109231","user":"瑞**","time":"6月26日","star":4.5,"text":"味道还可以，附近也没啥其他喝的了。","likes":0,"images":[]},{"id":"3309202430","user":"俊**","time":"6月21日","star":5,"text":"买家秀与卖家秀。这容量和图片一样吗？","likes":0,"images":["https://qcloud.dpfile.com/pc/ZuLebcSahRczrddOYL07FQ7_4ohbkC82DfrRARaTnkM2Vjb5915llVjv5IC0sqw9Elc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3302815366","user":"一**","time":"6月17日","star":5,"text":"要过节了，店里的小妹妹请我们喝茶百道的饮料，每人买了一杯青提茉莉中份的少冰7分糖，我基本上很少喝饮料的，哎，今天这个青提的味道还挺好喝的，又不是很甜，好喝，包装也很完美。夏天来了，喝这个饮料可以解暑降温。","likes":0,"images":["https://p0.meituan.net/coverpic/214fa5163d1b538de07ec220dd1e4eda86712.jpg%40400w_400h_1e_1l%7Cwatermark%3D0.webp","https://p1.meituan.net/ugcpic/3c2e09875bb01d1ff83c22eecdef7edd400226.jpg%401080w_1080h_1e_1l%7Cwatermark%3D0.webp","https://p0.meituan.net/ugcpic/54fcb865cc2494af69548b63a22c0a4a234839.jpg%401080w_1080h_1e_1l%7Cwatermark%3D0.webp","https://p1.meituan.net/ugcpic/c47e39f9b9a3bc060da0d707e2eddf7e208838.jpg%401080w_1080h_1e_1l%7Cwatermark%3D0.webp"]},{"id":"3279423487","user":"诗**","time":"6月2日","star":4,"text":"环境：干净整洁，看着还不错。\n口味：「手剥葡萄冻」不错的味道，个人喜欢的饮品了。\n口味：「西瓜啵啵」应季了的饮品选择，西瓜🍉口感一般的，没有预期效果的样子了，有点遗憾了。\n服务：服务态度不错的。\n性价比：性价比一般的\n👫🏻排队：有排队的人的。","likes":0,"images":["https://qcloud.dpfile.com/pc/qEMAmbEU-h9JYMEsPPwD2wqMNTpwUw3afw2jL9gM6P2R96YYeNt6mJRf097cNzq1Elc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3279173947","user":"s**","time":"6月2日","star":5,"text":"公司附近 经常光顾 还不错 人蛮多的","likes":0,"images":[]},{"id":"3241934284","user":"l**","time":"5月9日","star":4,"text":"前一阵的芭乐蛮好喝，今天看已经没有了，买了特价团的黄金百香芒芒，以前点他家别的奶茶一般都不额外加糖的，这款口感略酸，还是要加点糖好喝。","likes":0,"images":[]},{"id":"3203688526","user":"匿**","time":"4月17日","star":5,"text":"这次在茶百道点了芋泥奶茶，整体感觉比我预期要好。首先出杯速度还可以，我到店后大概等了3分钟就拿到了，包装也比较完整，没有出现漏杯或者杯身弄脏的情况。口味上我觉得甜度和冰度比较合适，奶香比较顺，茶底不会太涩，喝起来不会特别腻。店里环境虽然不算很大，但整体还算干净，点单和取餐流程也比较顺。价格放在同类茶饮里算正常，如果路过张江这边想买一杯日常饮品，这家我觉得是可以再来的。建议大家按自己口味选甜度，体验会更好一些。","likes":0,"images":[]},{"id":"3182752824","user":"匿**","time":"4月3日","star":4.5,"text":"环境：目前没有去过门店但看大众里面的评价看起来还不错\n口味：口味好喝好喝，推荐茶百道里面的杨枝甘露不错不错的，他们家的果茶也很好喝\n性价比：性价比还可以，人均¥15左右吧","likes":0,"images":["https://qcloud.dpfile.com/pc/zNSLXwqPWu3CtOb-vL-mfAR_JmN1p483mrOxxeabpF-1ovUUYcQmuIVWE256KpcHElc2-txFTxviA6n_fOE9QbySwTzJ2xmopuuSZkH1lSE.webp"]},{"id":"3180729928","user":"二**","time":"4月2日","star":4,"text":"「西瓜啵啵」喜欢这个，夏天喝很清爽","likes":0,"images":[]},{"id":"3170881601","user":"乖**","time":"3月27日","star":4.5,"text":"「杨枝甘露」真的很好喝 特别的清甜 喜欢","likes":0,"images":[]},{"id":"3166613086","user":"小**","time":"3