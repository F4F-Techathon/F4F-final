# Optional fallback only. Fill values from the provider that issued the key.
# `deepseek-pro` is kept as requested but its compatible Base URL cannot be inferred from the model name.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=restaurant-host

LLM_BASE_URL=
LLM_MODEL=deepseek-pro
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=22

COSYVOICE_DIR=C:/path/to/CosyVoice
COSY_FP16=1
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
