// The console's Vite config runs in Node.js.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.ts"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.director.node.tsbuildinfo"
  }
}
