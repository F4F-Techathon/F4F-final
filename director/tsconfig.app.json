// The test console runs in the browser; `@/` reaches the mobile app's src/ (rigs, generator, Jev client, stage protocol).
{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "paths": { "@/*": ["../src/*"] },
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.director.app.tsbuildinfo"
  }
}
